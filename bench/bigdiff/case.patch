@@ -0,0 +1,63 @@
+"""Value validators for records held in the store.
+
+Each validator is a callable taking the candidate value and returning the
+normalized value, or raising ValidationError with a message that names the
+offending constraint. Validators compose left-to-right through chain().
+"""
+
+
+class ValidationError(ValueError):
+    """A value failed validation; str(err) names the constraint."""
+
+
+def non_empty(value):
+    if value is None or (isinstance(value, str) and not value.strip()):
+        raise ValidationError("value must be non-empty")
+    return value
+
+
+def max_length(limit):
+    def check(value):
+        if len(value) > limit:
+            raise ValidationError(f"value exceeds {limit} characters")
+        return value
+    return check
+
+
+def one_of(*allowed):
+    allowed_set = set(allowed)
+
+    def check(value):
+        if value not in allowed_set:
+            names = ", ".join(sorted(map(str, allowed_set)))
+            raise ValidationError(f"value must be one of: {names}")
+        return value
+    return check
+
+
+def as_int(value):
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        raise ValidationError(f"not an integer: {value!r}")
+
+
+def in_range(low, high):
+    def check(value):
+        if not (low <= value <= high):
+            raise ValidationError(f"value must be between {low} and {high}")
+        return value
+    return check
+
+
+def chain(*validators):
+    """Compose validators left-to-right into a single validator."""
+    def check(value):
+        for validator in validators:
+            value = validator(value)
+        return value
+    return check
+
+
+PORT = chain(as_int, in_range(1, 65535))
+NAMESPACE = chain(non_empty, max_length(64))
