@@ -0,0 +1,49 @@
+"""Append-only operation journal for auditing store mutations.
+
+Every mutation appends one JSON line: {ts, op, namespace, key}. The journal
+is best-effort by design -- a failed append never blocks the mutation -- but
+failures are counted so callers can surface persistent trouble.
+"""
+import json
+import time
+
+
+class Journal:
+    def __init__(self, path):
+        self.path = path
+        self.failed_appends = 0
+
+    def record(self, op, key, namespace="default"):
+        entry = {
+            "ts": round(time.time(), 3),
+            "op": op,
+            "namespace": namespace,
+            "key": key,
+        }
+        line = json.dumps(entry, sort_keys=True)
+        try:
+            with open(self.path, "a") as fh:
+                fh.write(line + "\n")
+        except OSError:
+            self.failed_appends += 1
+
+    def entries(self):
+        """Yield parsed journal entries, skipping torn trailing lines."""
+        try:
+            fh = open(self.path)
+        except FileNotFoundError:
+            return
+        with fh:
+            for raw in fh:
+                raw = raw.strip()
+                if not raw:
+                    continue
+                try:
+                    yield json.loads(raw)
+                except json.JSONDecodeError:
+                    continue
+
+    def entries_for(self, namespace):
+        for entry in self.entries():
+            if entry.get("namespace") == namespace:
+                yield entry
